{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true
  },
  "settings": {
    "react": {
      "version": "19.2.7"
    },
    "tailwindcss": {
      "callees": ["clsx", "cva", "cn"]
    }
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    ".turbo/",
    ".vinxi/",
    ".nitro/",
    ".agents/",
    "build/",
    ".tanstack/",
    ".coverage/",
    "nix/store/",
    ".pnpm-store/",
    "packages/types/",
    "packages/wasm/pkg/",
    "generated/",
    "generated.ts",
    "pnpm-lock.yaml",
    "src/routeTree.gen.ts",
    ".output/"
  ],
  "rules": {
    "prefer-arrow-callback": "error",
    "no-unsafe-finally": "warn",
    "@typescript-eslint/no-unused-vars": "error",
    "no-unused-vars": "error",
    "no-eval": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "smart"],
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-namespace": "error",
    "no-var": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "@typescript-eslint/no-extra-non-null-assertion": "error",
    "no-shadow": "warn",
    "no-shadow-restricted-names": "error",
    "@typescript-eslint/no-unsafe-declaration-merging": "error",
    "@typescript-eslint/no-unsafe-type-assertion": "off",
    "@typescript-eslint/restrict-template-expressions": "off",
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/await-thenable": "warn",
    "@typescript-eslint/no-base-to-string": "off",
    "@typescript-eslint/no-unnecessary-type-conversion": "off",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "jsx-a11y/control-has-associated-label": "warn",
    "jsx-a11y/anchor-has-content": "warn",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    "jsx-a11y/anchor-is-valid": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "@typescript-eslint/unbound-method": "warn",
    "no-control-regex": "warn",
    "getter-return": "error",
    "no-debugger": "warn",
    "react/no-unstable-nested-components": ["warn", { "allowAsProps": true }],
    "@typescript-eslint/no-unnecessary-type-parameters": "off",
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "camelCase": true,
          "pascalCase": true
        },
        "ignore": [
          "\\.config\\.ts$",
          "\\.d\\.ts$",
          "llms.*\\.txt\\.ts$",
          "rss\\.xml\\.ts$",
          "agent\\.md\\.ts$",
          ".*\\.astro$",
          "\\[.*\\]\\.webp\\.ts$",
          "case-studies",
          "\\.md$",
          "\\.mdx$",
          "routeTree\\.gen\\.ts$"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/data-table/data-table.tsx", "**/data-table.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": [
        "**/approval-card/approval-card.tsx",
        "**/progress-tracker/progress-tracker.tsx",
        "**/preferences-panel/preferences-panel.tsx",
        "**/plan/plan.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["*.mdx", "*.md", "*.astro"],
      "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": "off",
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["**/label.tsx"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off"
      }
    },
    {
      "files": ["**/field.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "no-underscore-dangle": "off",
        "@typescript-eslint/unbound-method": "off"
      }
    },
    {
      "files": ["**/goey-toaster.tsx", "**/sonner.tsx"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": [
        "**/spinner.tsx",
        "**/logo.tsx",
        "**/carousel.tsx",
        "**/button-group.tsx",
        "**/input-group.tsx",
        "**/input-otp.tsx",
        "**/item.tsx",
        "**/breadcrumb.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["**/pagination.tsx", "**/nav-projects.tsx", "**/leatest-change.tsx", "**/not-found.tsx"],
      "rules": {
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/control-has-associated-label": "off"
      }
    },
    {
      "files": ["**/sanitize-href.ts"],
      "rules": {
        "no-control-regex": "off"
      }
    },
    {
      "files": ["**/wasm/src/utils.ts"],
      "rules": {
        "@typescript-eslint/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["**/calendar.tsx"],
      "rules": {
        "no-shadow": "off"
      }
    },
    {
      "files": ["**/approval-card.tsx", "**/input-group.tsx"],
      "rules": {
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/click-events-have-key-events": "off"
      }
    },
    {
      "files": ["**/data-table/data-table.tsx", "**/tool-ui/data-table/**"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": [
        "**/approval-card/approval-card.tsx",
        "**/progress-tracker/progress-tracker.tsx",
        "**/preferences-panel/preferences-panel.tsx",
        "**/plan/plan.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ]
}
